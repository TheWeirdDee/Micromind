# Get FREE at https://console.groq.com (no credit card needed)
GROQ_API_KEY=gsk_your_key_here

# Fill after deploying smart contract
CONTRACT_ADDRESS=0x_your_contract_address

# Your deployer wallet private key (for agent wallet — create new one)
PRIVATE_KEY=0x_your_private_key

# OPTIONAL: Get FREE at https://upstash.com
# Without these, app uses in-memory storage (data lost on restart)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# From https://8004.xyz (required for AI Agent prize track)
AGENT_8004_ID=

# From https://self.xyz (required for AI Agent prize track)
SELF_AGENT_ID=

# true for Alfajores testnet, false for Celo mainnet
IS_TESTNET=true

PORT=3001

# Get FREE at https://resend.com
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=MicroMind Letters <letters@micromindapp.xyz>
SUPPORT_EMAIL=micromind16@gmail.com

# REQUIRED — /api/cron/release-letters decrypts and emails real letter content
# and refuses ALL requests if this is unset. Must match the Authorization:
# Bearer value the release-letters cron (GitHub Actions) sends.
CRON_SECRET=

# Web Push (daily reminder notifications) — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY must match NEXT_PUBLIC_VAPID_PUBLIC_KEY in the frontend's env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

